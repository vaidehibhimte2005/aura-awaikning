# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the React app)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for upload URLs and sitemap)
API_URL=http://localhost:5000
# Public URL of the website (used in sitemap, emails, Stripe redirects)
SITE_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/aura_awakening

# ─── Auth ──────────────────────────────────────────────────
# Use long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ─── Payments ──────────────────────────────────────────────
# razorpay | stripe | mock   (mock is refused when NODE_ENV=production)
PAYMENT_PROVIDER=mock
DEFAULT_CURRENCY=INR

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── YouTube (optional: used to read video metadata) ───────
YOUTUBE_API_KEY=

# ─── Email (optional — notifications fall back to in-app only)
# Email verification is enforced only when mail is configured. Set true/false to override.
# REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Aura Awakening <hello@auraawakening.com>"

# ─── File storage ──────────────────────────────────────────
# local | cloudinary | s3   (cloudinary / s3 drivers are stubs ready to be completed)
STORAGE_DRIVER=local
UPLOAD_MAX_MB=5

# ─── Seed admin (used by `npm run seed`) ───────────────────
SEED_ADMIN_EMAIL=admin@auraawakening.com
SEED_ADMIN_PASSWORD=ChangeMe@123

# ─── Live sessions: meeting provider ───────────────────────
# demo (default): no real video call is created; sessions open a clearly-labelled in-app demo room.
# zoom: needs all four ZOOM_* values (Zoom Server-to-Server OAuth app + Event Subscription for
#       meeting.participant_joined / meeting.participant_left → POST {API_URL}/api/meetings/webhook/zoom)
MEETING_PROVIDER=demo
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=
